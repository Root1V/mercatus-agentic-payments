# Copia este archivo a .env y ajusta solo lo que necesites.
# En modo mock (el default) no se necesita NADA de esto: el framework corre
# entero sin credenciales ni fondos reales.

# --- Qué protocolo de pago y qué modo -------------------------------------
AGENT_COMMERCE_PROTOCOL=x402       # x402 | ap2
AGENT_COMMERCE_MODE=mock           # mock | testnet
AGENT_COMMERCE_WALLET_BACKEND=local # local | circle
AGENT_COMMERCE_NETWORK=eip155:84532 # Base Sepolia (CAIP-2)

# --- Solo si AGENT_COMMERCE_MODE=testnet con wallet_backend=local --------
# Claves EVM ya financiadas con USDC de testnet en Base Sepolia.
# NUNCA pongas aquí una clave con fondos reales de mainnet.
# AGENT_COMMERCE_BUYER_PRIVATE_KEY=0x...
# AGENT_COMMERCE_SELLER_PRIVATE_KEY=0x...

# Facilitator x402 remoto a usar en modo testnet (por defecto https://x402.org/facilitator)
# AGENT_COMMERCE_FACILITATOR_URL=https://x402.org/facilitator

# --- Solo si AGENT_COMMERCE_WALLET_BACKEND=circle -------------------------
# Requiere: pip install "agent-commerce[circle]"
# AGENT_COMMERCE_CIRCLE_API_KEY=...
# AGENT_COMMERCE_CIRCLE_ENTITY_SECRET=...
# AGENT_COMMERCE_CIRCLE_BUYER_WALLET_ID=...
# AGENT_COMMERCE_CIRCLE_SELLER_WALLET_ID=...

# --- Dirección que recibe los pagos del vendedor de ejemplo ---------------
# Si no la fijas, cada corrida genera una dirección local nueva.
# AGENT_COMMERCE_SELLER_PAY_TO_ADDRESS=0x...

# --- Dashboard: persistencia (Postgres) + auth JWT -------------------------
# Requiere: uv sync --extra dashboard  (o pip install "agent-commerce[dashboard]")
# Sin AGENT_COMMERCE_JWT_SECRET_KEY el dashboard no arranca -- generá uno con
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
AGENT_COMMERCE_DATABASE_URL=postgresql+psycopg://agent_commerce:agent_commerce@localhost:5432/agent_commerce
AGENT_COMMERCE_JWT_SECRET_KEY=
AGENT_COMMERCE_JWT_ALGORITHM=HS256
AGENT_COMMERCE_JWT_EXPIRES_MINUTES=1440

# Usados solo por `agent-commerce create-admin` en modo no interactivo
# (p. ej. dentro de Docker); si faltan, el comando pregunta por consola.
# AGENT_COMMERCE_ADMIN_USERNAME=admin
# AGENT_COMMERCE_ADMIN_PASSWORD=

# --- Solo para docker-compose.yml ------------------------------------------
# POSTGRES_PASSWORD=agent_commerce
# JWT_SECRET_KEY=                     # docker-compose lo mapea a AGENT_COMMERCE_JWT_SECRET_KEY
